  "cards": [
    {
      "dot": "cyan",
      "title": "Authentication & CORS Hardening",
      "items": [
        "verify_api_key() enforces X-API-Key header on POST /frames, POST /events, and POST /edge/config",
        "Optional on localhost when AIIOT_API_KEY is unset; strictly required when bound to 0.0.0.0 or remote host",
        "CORS allow_origins restricted to http://localhost:5173 and http://localhost:5174"
      ]
    },
    {
      "dot": "emerald",
      "title": "Decompression-Bomb & Memory Protection",
      "items": [
        "Content-Length header is checked against 2 MB BEFORE awaiting request.body() to prevent RAM exhaustion",
        "_get_jpeg_dimensions() parses JPEG SOF markers and rejects images wider or taller than 4096px",
        "Worker thread also verifies decoded ndarray dimensions <= 4096x4096 before ONNX inference"
      ]
    },
    {
      "dot": "rose",
      "title": "Config Bounds & Path-Traversal Prevention",
      "items": [
        "EdgeConfigUpdate enforces fps in [0.5, 30.0], width in [160, 1920], and quality in [10, 100]",
        "validate_source() restricts file sources to data/*.mp4 (verified via os.path.commonpath), camera index, or http/https/rtsp",
        "Blocks local file probing (../secret.mp4, C:/Windows/...) and arbitrary file:// URIs"
      ]
    }
  ]
}
