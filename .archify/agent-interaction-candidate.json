  "cards": [
    {
      "dot": "cyan",
      "title": "Ingestion & Perception Components",
      "items": [
        "Edge Capture Client: Captures frames, resizes to 640px, encodes JPEG (q=70), and streams POST /frames.",
        "Ingest API Gateway: Enforces X-API-Key, Content-Length <= 2 MB, JPEG SOF <= 4096px, and drop-oldest queue.",
        "CV Worker & ONNX Detector: Dequeues frames, runs YOLO26n ONNX in 27.6ms on CPU, and renders annotated JPEGs."
      ]
    },
    {
      "dot": "emerald",
      "title": "Pipeline, Rule Engine & Tracker",
      "items": [
        "Pipeline Coordinator: Serializes per-device state under ingest_lock and debounces event logging (2s).",
        "Rule Engine: Evaluates R1 crowd spikes (>3), R2 unexpected objects (>=5s), and R3 dwell (>=30s) per track_id.",
        "Centroid Tracker: Tracks objects (15s timeout, 0.40/0.30 hysteresis) and binds initial nearby person as owner."
      ]
    },
    {
      "dot": "rose",
      "title": "Actuation, Storage & React Consoles",
      "items": [
        "Alert Dispatcher: Triggers console banner, platform beep, and 15s active alert flag for red frame border.",
        "SQLite WAL Store: Persists events, anomalies, and frame_metrics in events.db with 5000ms busy_timeout.",
        "React Consoles: Analytics Console (:5173) and Edge Control Deck (:5174) poll REST endpoints."
      ]
    }
  ]
